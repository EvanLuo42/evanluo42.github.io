---
import { experiences } from '../data/experience';
---

<section id="experience" class="py-12 sm:py-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 class="text-3xl font-bold text-stone-900 tracking-tight">
      Experience
    </h2>
    <p class="mt-2 text-stone-500">Research and industry positions</p>

    <div class="mt-8 relative">
      <!-- Timeline line -->
      <div class="absolute left-[7px] top-2 bottom-2 w-0.5 bg-stone-200"></div>

      <div class="space-y-8">
        {experiences.map(exp => (
          <div class="relative pl-8">
            <!-- Timeline dot -->
            <div class={`absolute left-0 top-1.5 w-[15px] h-[15px] rounded-full border-2 ${exp.current ? 'bg-teal-600 border-teal-600 ring-4 ring-teal-100' : 'bg-white border-stone-300'}`}></div>

            <div class="bg-white rounded-xl p-4 sm:p-5 border border-stone-200 shadow-sm">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
                <h3 class="text-lg font-semibold text-stone-900">{exp.role}</h3>
                <span class="text-sm text-stone-400 font-medium whitespace-nowrap">{exp.period}</span>
              </div>
              <p class="text-teal-700 font-medium text-sm">{exp.org}</p>
              <p class="text-stone-400 text-xs">{exp.dept}</p>
              <p class="mt-2 text-sm text-stone-600 leading-relaxed">{exp.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
