---
import { getCollection } from "astro:content";

const allPubs = await getCollection("publications");
const allPreprints = await getCollection("preprints");
const highlightedAuthor = "Evan Luo";

const selected = allPubs.filter((p) => p.data.selected);

const statusLabels: Record<string, string> = {
    preprint: "Preprint",
    manuscript: "Manuscript",
    "under review": "Under Review",
    "in preparation": "In Preparation",
};

type CombinedItem = {
    kind: "pub" | "preprint";
    data: { title: string; authors: string[]; year: number; venue?: string; status?: string; tags: string[]; links: { paper?: string; code?: string; arxiv?: string }; selected?: boolean };
    body?: string;
};

const combined: CombinedItem[] = [
    ...allPubs.map((p) => ({ kind: "pub" as const, data: { ...p.data, venue: p.data.venue }, body: p.body })),
    ...allPreprints.map((p) => ({ kind: "preprint" as const, data: { ...p.data, status: p.data.status }, body: p.body })),
];

const allByYear = combined.reduce(
    (acc, item) => {
        (acc[item.data.year] = acc[item.data.year] || []).push(item);
        return acc;
    },
    {} as Record<number, CombinedItem[]>,
);
const sortedYears = Object.keys(allByYear)
    .map(Number)
    .sort((a, b) => b - a);
---

{(allPubs.length > 0 || allPreprints.length > 0) && (
<section id="publications" class="py-12 sm:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
        {selected.length > 0 && (
        <>
        <h2 class="text-3xl font-bold text-stone-900 tracking-tight">
            Selected Publications
        </h2>
        <p class="mt-2 text-stone-500">Research contributions</p>

        <div class="mt-8 space-y-6">
            {
                selected.map((pub) => (
                    <article class="group bg-white rounded-xl p-4 sm:p-6 shadow-sm border border-stone-200 hover:border-teal-300 hover:shadow-md transition-all">
                        <div class="flex items-start justify-between gap-4">
                            <div class="flex-1">
                                <h3 class="text-lg font-semibold text-stone-900 group-hover:text-teal-800 transition-colors leading-snug">
                                    {pub.data.title}
                                </h3>
                                <p class="mt-1.5 text-sm text-stone-500">
                                    {pub.data.authors.map((a, i) => (
                                        <>
                                            {i > 0 && ", "}
                                            <span
                                                class={
                                                    a === highlightedAuthor
                                                        ? "font-semibold text-stone-700"
                                                        : ""
                                                }
                                            >
                                                {a}
                                            </span>
                                        </>
                                    ))}
                                </p>
                                <p class="mt-2 text-sm text-stone-500 leading-relaxed">
                                    {pub.body}
                                </p>
                                <div class="mt-3 flex flex-wrap items-center gap-2">
                                    <span class="px-2.5 py-0.5 text-xs font-semibold bg-teal-700 text-white rounded-md">
                                        {pub.data.venue}
                                    </span>
                                    {pub.data.tags.map((tag) => (
                                        <span class="px-2 py-0.5 text-xs font-medium bg-stone-100 text-stone-600 rounded-md">
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        </div>
                        <div class="mt-3 sm:mt-4 flex flex-wrap items-center gap-2 text-sm">
                            {pub.data.links.paper && (
                                <a
                                    href={pub.data.links.paper}
                                    class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md border border-teal-200 bg-teal-50 text-teal-700 hover:bg-teal-100 hover:text-teal-900 font-medium transition-colors"
                                >
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                    Paper
                                </a>
                            )}
                            {pub.data.links.code && (
                                <a href={pub.data.links.code} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md border border-teal-200 bg-teal-50 text-teal-700 hover:bg-teal-100 hover:text-teal-900 font-medium transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                                    </svg>
                                    Code
                                </a>
                            )}
                            {pub.data.links.arxiv && (
                                <a href={pub.data.links.arxiv} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md border border-teal-200 bg-teal-50 text-teal-700 hover:bg-teal-100 hover:text-teal-900 font-medium transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                                    </svg>
                                    arXiv
                                </a>
                            )}
                        </div>
                    </article>
                ))
            }
        </div>
        </>
        )}

        <div class={selected.length > 0 ? "mt-20" : "mt-8"}>
            <h2 class="text-3xl font-bold text-stone-900 tracking-tight">
                All Publications
            </h2>
            <p class="mt-2 text-stone-500">
                Complete list of publications and preprints by year
            </p>
            <div class="mt-8 space-y-10">
                {
                    sortedYears.map((year) => (
                        <div>
                            <h3 class="text-xl font-bold text-stone-400 mb-4 border-b border-stone-200 pb-2">
                                {year}
                            </h3>
                            <div class="space-y-4">
                                {allByYear[year].map((item) => (
                                    <article class="group pl-4 border-l-2 border-stone-200 hover:border-teal-500 transition-colors">
                                        <h4 class="font-semibold text-stone-800 group-hover:text-teal-800 transition-colors leading-snug">
                                            {item.data.title}
                                        </h4>
                                        <p class="mt-1 text-sm text-stone-500">
                                            {item.data.authors.map((a, i) => (
                                                <>
                                                    {i > 0 && ", "}
                                                    <span class={a === highlightedAuthor ? "font-semibold text-stone-700" : ""}>
                                                        {a}
                                                    </span>
                                                </>
                                            ))}
                                        </p>
                                        <div class="mt-2 flex flex-wrap items-center gap-2">
                                            {item.kind === "pub" && item.data.venue && (
                                                <span class="px-2 py-0.5 text-xs font-semibold bg-teal-50 text-teal-800 rounded border border-teal-200">
                                                    {item.data.venue}
                                                </span>
                                            )}
                                            {item.kind === "preprint" && item.data.status && (
                                                <span class="px-2 py-0.5 text-xs font-semibold bg-teal-50 text-teal-800 rounded border border-teal-200">
                                                    {statusLabels[item.data.status] || item.data.status}
                                                </span>
                                            )}
                                            {item.kind === "pub" && item.data.selected && (
                                                <span class="px-2 py-0.5 text-xs font-medium bg-amber-50 text-amber-700 rounded border border-amber-200">
                                                    ★ Selected
                                                </span>
                                            )}
                                            {item.data.tags.map((tag) => (
                                                <span class="px-2 py-0.5 text-xs font-medium bg-stone-100 text-stone-600 rounded-md">
                                                    {tag}
                                                </span>
                                            ))}
                                            <div class="flex items-center gap-2 sm:ml-auto text-xs">
                                                {item.data.links.paper && (
                                                    <a href={item.data.links.paper} class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md border border-teal-200 bg-teal-50 text-teal-700 hover:bg-teal-100 hover:text-teal-900 font-medium transition-colors">
                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                                        </svg>
                                                        Paper
                                                    </a>
                                                )}
                                                {item.data.links.code && (
                                                    <a href={item.data.links.code} target="_blank" rel="noopener" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md border border-teal-200 bg-teal-50 text-teal-700 hover:bg-teal-100 hover:text-teal-900 font-medium transition-colors">
                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                                                        </svg>
                                                        Code
                                                    </a>
                                                )}
                                                {item.data.links.arxiv && (
                                                    <a href={item.data.links.arxiv} target="_blank" rel="noopener" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md border border-teal-200 bg-teal-50 text-teal-700 hover:bg-teal-100 hover:text-teal-900 font-medium transition-colors">
                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                                                        </svg>
                                                        arXiv
                                                    </a>
                                                )}
                                            </div>
                                        </div>
                                    </article>
                                ))}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>
)}
