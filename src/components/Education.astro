---
import { education } from "../data/experience";
---

<section id="education" class="py-12 sm:py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <h2 class="text-3xl font-bold text-stone-900 tracking-tight">
            Education
        </h2>
        <p class="mt-2 text-stone-500">Academic background</p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {
                education.map((edu) => (
                    <div class="bg-stone-50 rounded-xl p-5 border border-stone-200">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="w-10 h-10 rounded-lg bg-teal-50 flex items-center justify-center">
                                <svg
                                    class="w-5 h-5 text-teal-700"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M12 14l9-5-9-5-9 5 9 5z"
                                    />
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"
                                    />
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422M21 12v7"
                                    />
                                </svg>
                            </div>
                            <div>
                                <h3 class="font-semibold text-stone-900">
                                    {edu.degree}
                                </h3>
                                <p class="text-sm text-teal-700 font-medium">
                                    {edu.school}
                                </p>
                            </div>
                        </div>
                        <p class="text-xs text-stone-400 font-medium">
                            {edu.period}
                        </p>
                        <p class="mt-1 text-sm text-stone-600">{edu.detail}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
