---
import { profile } from "../data/profile";

const base = import.meta.env.BASE_URL;

const navLinks = [
    { label: "About", href: "#about" },
    { label: "Publications", href: "#publications" },
    { label: "Education", href: "#education" },
    { label: "Experience", href: "#experience" },
    { label: "Projects", href: "#projects" },
    { label: "Contact", href: "#contact" },
];
---

<nav
    class="sticky top-0 z-50 bg-stone-50/80 backdrop-blur-md border-b border-stone-200"
>
    <div
        class="max-w-5xl mx-auto px-4 sm:px-6 py-3 sm:py-4 flex items-center justify-between"
    >
        <a
            href={base}
            class="text-lg font-semibold text-stone-900 tracking-tight hover:text-teal-700 transition-colors"
        >
            {profile.name}
        </a>

        <!-- Desktop nav -->
        <ul class="hidden md:flex items-center gap-8">
            {
                navLinks.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            class="text-sm text-stone-500 hover:text-teal-700 transition-colors font-medium"
                        >
                            {link.label}
                        </a>
                    </li>
                ))
            }
            <li>
                <a
                    href={`${base}/cv.pdf`}
                    class="text-sm font-medium px-4 py-2 rounded-lg bg-teal-700 text-white hover:bg-teal-800 transition-colors"
                >
                    CV ↓
                </a>
            </li>
        </ul>

        <!-- Mobile menu button -->
        <button
            id="mobile-menu-btn"
            class="md:hidden p-2 text-stone-600 hover:text-stone-900 transition-colors"
            aria-label="Toggle menu"
        >
            <svg
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>

    <!-- Mobile menu -->
    <div
        id="mobile-menu"
        class="hidden md:hidden border-t border-stone-200 bg-stone-50"
    >
        <ul class="px-6 py-4 space-y-3">
            {
                navLinks.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            class="block text-sm text-stone-600 hover:text-teal-700 transition-colors font-medium"
                        >
                            {link.label}
                        </a>
                    </li>
                ))
            }
            <li>
                <a
                    href={`${base}/cv.pdf`}
                    class="inline-block text-sm font-medium px-4 py-2 rounded-lg bg-teal-700 text-white hover:bg-teal-800 transition-colors"
                >
                    Download CV
                </a>
            </li>
        </ul>
    </div>
</nav>

<script>
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    btn?.addEventListener("click", () => {
        menu?.classList.toggle("hidden");
    });
    menu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
            menu?.classList.add("hidden");
        });
    });
</script>
