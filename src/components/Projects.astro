---
import { projects } from "../data/projects";
---

<section id="projects" class="py-12 sm:py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <h2 class="text-3xl font-bold text-stone-900 tracking-tight">
            Projects
        </h2>
        <p class="mt-2 text-stone-500">
            Open-source tools and research software
        </p>

        <div class="mt-8 grid gap-6 sm:grid-cols-2">
            {
                projects.map((project) => (
                    <article class="group bg-stone-50 rounded-xl p-4 sm:p-6 shadow-sm border border-stone-200 hover:border-teal-300 hover:shadow-md transition-all flex flex-col">
                        <div class="flex items-start justify-between">
                            <div class="flex items-center gap-2">
                                <svg
                                    class="w-5 h-5 text-stone-400"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
                                    />
                                </svg>
                                <h3 class="text-lg font-semibold text-stone-900 group-hover:text-teal-800 transition-colors">
                                    {project.title}
                                </h3>
                            </div>
                            <span
                                class={`px-2 py-0.5 text-xs font-medium rounded-full ${project.status === "Active" ? "bg-green-50 text-green-700 border border-green-200" : "bg-stone-100 text-stone-500 border border-stone-200"}`}
                            >
                                {project.status}
                            </span>
                        </div>

                        <p class="mt-3 text-sm text-stone-600 leading-relaxed flex-1">
                            {project.description}
                        </p>

                        <div class="mt-4 flex flex-wrap gap-1.5">
                            {project.tags.map((tag) => (
                                <span class="px-2 py-0.5 text-xs font-medium bg-stone-100 text-stone-500 rounded">
                                    {tag}
                                </span>
                            ))}
                        </div>

                        <div class="mt-4 pt-4 border-t border-stone-100 flex items-center justify-between">
                            <div class="flex items-center gap-3 text-sm">
                                {project.links.github && (
                                    <a
                                        href={project.links.github}
                                        target="_blank"
                                        rel="noopener"
                                        class="inline-flex items-center gap-1 text-teal-700 hover:text-teal-900 font-medium transition-colors"
                                    >
                                        <svg
                                            class="w-4 h-4"
                                            viewBox="0 0 24 24"
                                            fill="currentColor"
                                        >
                                            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                                        </svg>
                                        GitHub
                                    </a>
                                )}
                                {project.links.demo && (
                                    <a
                                        href={project.links.demo}
                                        class="text-teal-700 hover:text-teal-900 font-medium transition-colors"
                                    >
                                        Demo
                                    </a>
                                )}
                                {project.links.docs && (
                                    <a
                                        href={project.links.docs}
                                        class="text-teal-700 hover:text-teal-900 font-medium transition-colors"
                                    >
                                        Docs
                                    </a>
                                )}
                                {project.links.paper && (
                                    <a
                                        href={project.links.paper}
                                        class="text-teal-700 hover:text-teal-900 font-medium transition-colors"
                                    >
                                        Paper
                                    </a>
                                )}
                            </div>
                            {project.stars && (
                                <span class="inline-flex items-center gap-1 text-xs text-stone-400">
                                    <svg
                                        class="w-3.5 h-3.5"
                                        fill="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                    </svg>
                                    {project.stars}
                                </span>
                            )}
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>
