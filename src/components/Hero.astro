---
import { profile } from "../data/profile";
import { contact } from "../data/contact";
---

<section id="about" class="pt-16 sm:pt-20 pb-12 sm:pb-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div
            class="flex flex-col md:flex-row gap-8 items-center md:items-start text-center md:text-left"
        >
            <!-- Left column: Avatar + contacts -->
            <div class="flex-shrink-0 flex flex-col items-center">
                <div
                    class="w-56 h-56 md:w-64 md:h-64 rounded-2xl bg-gradient-to-br from-teal-100 to-stone-200 overflow-hidden shadow-lg ring-4 ring-white"
                >
                    <img
                        src="/avatar.jpeg"
                        alt={profile.name}
                        class="w-full h-full object-cover object-[center_10%]"
                    />
                </div>

                <!-- Quick social links under photo -->
                <div class="flex items-center gap-4 mt-4 justify-center">
                    <a
                        href={`mailto:${contact.email}`}
                        class="text-stone-400 hover:text-teal-700 transition-colors"
                        aria-label="Email"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                            ></path></svg
                        >
                    </a>
                    <a
                        href={profile.social.scholar}
                        target="_blank"
                        rel="noopener"
                        class="text-stone-400 hover:text-teal-700 transition-colors"
                        aria-label="Google Scholar"
                    >
                        <svg
                            class="w-6 h-6"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            ><path
                                d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"
                            ></path></svg
                        >
                    </a>
                    <a
                        href={profile.social.github}
                        target="_blank"
                        rel="noopener"
                        class="text-stone-400 hover:text-teal-700 transition-colors"
                        aria-label="GitHub"
                    >
                        <svg
                            class="w-6 h-6"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            ><path
                                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
                            ></path></svg
                        >
                    </a>
                    <a
                        href={profile.social.orcid}
                        target="_blank"
                        rel="noopener"
                        class="text-stone-400 hover:text-teal-700 transition-colors"
                        aria-label="ORCID"
                    >
                        <svg
                            class="w-6 h-6"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            ><path
                                d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-1.847-1.178-3.722-3.953-3.722h-2.366z"
                            ></path></svg
                        >
                    </a>
                    <a
                        href={profile.social.linkedin}
                        target="_blank"
                        rel="noopener"
                        class="text-stone-400 hover:text-teal-700 transition-colors"
                        aria-label="LinkedIn"
                    >
                        <svg
                            class="w-6 h-6"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            ><path
                                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                            ></path></svg
                        >
                    </a>
                </div>
            </div>

            <!-- Right column: Bio + interests -->
            <div class="flex-1 min-w-0">
                <h1
                    class="text-4xl md:text-5xl font-bold text-stone-900 tracking-tight"
                >
                    {profile.name}
                </h1>
                <p class="mt-2 text-lg text-teal-700 font-medium">
                    {profile.title}
                </p>
                <p class="mt-1 text-stone-500">
                    {profile.affiliation}
                </p>

                <div class="mt-6 space-y-4 text-stone-600 leading-relaxed">
                    {profile.bio.map((paragraph) => <p set:html={paragraph} />)}
                </div>

                <!-- Research interests tags -->
                <div class="mt-6">
                    <h3
                        class="text-xs font-semibold uppercase tracking-wider text-stone-400 mb-3"
                    >
                        Research Interests
                    </h3>
                    <div
                        class="flex flex-wrap gap-2 justify-center md:justify-start"
                    >
                        {
                            profile.researchInterests.map((tag) => (
                                <span class="px-3 py-1 text-sm font-medium bg-teal-50 text-teal-800 rounded-full border border-teal-200">
                                    {tag}
                                </span>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
